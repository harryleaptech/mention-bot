# Discord bot token (Developer Portal > your app > Bot > Reset Token)
DISCORD_TOKEN=

# Your own Discord user ID (Settings > Advanced > Developer Mode, then right-click yourself > Copy User ID)
DISCORD_OWNER_ID=

# GitHub personal access token (classic) with the "notifications" scope,
# plus "repo" if it should read and comment on private repos.
# Leave empty to turn the GitHub side off.
GITHUB_TOKEN=

# Optional: how your replies should sound.
REPLY_STYLE=Short, friendly and direct. Plain language. No emojis.

# Optional: seconds between GitHub checks (GitHub may ask for a longer wait).
GITHUB_POLL_SECONDS=60

# Optional: Claude model alias passed to `claude --model` (empty = your default).
CLAUDE_MODEL=
