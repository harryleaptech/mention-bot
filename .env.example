# Discord bot token (Developer Portal > your app > Bot > Reset Token)
DISCORD_TOKEN=

# Your own Discord user ID (Settings > Advanced > Developer Mode, then right-click yourself > Copy User ID)
DISCORD_OWNER_ID=

# GitHub personal access token (classic) with the "notifications" scope,
# plus "repo" if it should read and comment on private repos.
# Leave empty to turn the GitHub side off.
GITHUB_TOKEN=

# Optional: how your replies should sound.
REPLY_STYLE=Short, friendly and direct. Plain language. No emojis.

# Optional: seconds between GitHub checks (GitHub may ask for a longer wait).
GITHUB_POLL_SECONDS=60

# Optional: Claude model alias passed to `claude --model` (empty = your default).
CLAUDE_MODEL=

# Design check posts (npm run design-check). Right-click the channel > Copy Channel ID.
# The forum where previews go, and the team channel that gets the link line.
DESIGN_CHECK_FORUM_ID=
DESIGN_CHECK_LINK_CHANNEL_ID=
# Optional: the user ID that "@D" in a preview turns into (the person who answers).
DESIGN_CHECK_MENTION_ID=

# Task board (http://127.0.0.1:4747). A card moved to "Doing" runs with your local Claude Code.
# Comma-separated folders a task may run in; empty turns the board off.
BOARD_DIRS=
# Optional: port, and minutes before a run is stopped.
BOARD_PORT=4747
BOARD_TIMEOUT_MINUTES=30
