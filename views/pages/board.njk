{% extends "layout.njk" %}
{% set title = "Task board" %}

{% block content %}
  {% if notice %}
    {{ govukNotificationBanner({ type: "success", text: notice }) }}
  {% endif %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l govuk-!-margin-bottom-2">Task board</h1>
      <p class="govuk-body-s board-intro">Mentions wait with a drafted reply; nothing is posted until you press Send. A started task runs with Claude Code and ends as local changes; you get a DM when it finishes.</p>
    </div>
    <div class="govuk-grid-column-one-third board-add">
      {{ govukButton({ text: "Add a task", href: "/tasks/new" }) }}
    </div>
  </div>

  {#- Live or Manual updates. Needs JavaScript, so it stays hidden until board.js shows it. -#}
  <div class="board-mode" id="board-mode" hidden>
    <fieldset class="govuk-fieldset board-mode__fieldset">
      <legend class="govuk-fieldset__legend board-mode__legend">Updates</legend>
      <div class="govuk-radios govuk-radios--small govuk-radios--inline" data-module="govuk-radios">
        <div class="govuk-radios__item">
          <input class="govuk-radios__input" id="mode-live" name="mode" type="radio" value="live">
          <label class="govuk-label govuk-radios__label" for="mode-live">Live</label>
        </div>
        <div class="govuk-radios__item">
          <input class="govuk-radios__input" id="mode-manual" name="mode" type="radio" value="manual">
          <label class="govuk-label govuk-radios__label" for="mode-manual">Manual</label>
        </div>
      </div>
    </fieldset>
    <div class="board-mode__theme">
      <label class="govuk-label board-mode__legend" for="board-theme">Theme</label>
      <select class="govuk-select board-mode__select" id="board-theme">
        <option value="govuk">GOV.UK</option>
        <option value="modern">Modern</option>
        <option value="dark">Modern dark</option>
        <option value="auto">Auto (follows your Mac)</option>
      </select>
    </div>
    <span class="board-mode__status" id="board-live-status" role="status"></span>
    <span class="board-mode__pending" id="board-pending" hidden>New updates</span>
    <button type="button" class="govuk-button govuk-button--secondary board-btn board-mode__refresh" id="board-refresh" hidden>Refresh</button>
  </div>

  <div id="columns" data-busy="{{ 1 if busy else 0 }}">
    {% include "partials/columns.njk" %}
  </div>
  <div class="govuk-visually-hidden" aria-live="polite" id="columns-status"></div>
{% endblock %}
