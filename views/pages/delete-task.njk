{% extends "layout.njk" %}
{% set title = "Delete task" %}

{% block beforeContent %}
  {{ govukBackLink({ text: "Back", href: "/tasks/" + card.id }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">Are you sure you want to delete this task?</h1>
      <p class="govuk-body govuk-!-font-weight-bold">{{ card.title }}</p>
      {{ govukWarningText({ text: "The task and its result are removed from the board. Changes it made to files stay where they are." }) }}

      {% if card.busy %}
        <p class="govuk-body">It is running. Wait for it to finish, then delete it.</p>
        <a class="govuk-link" href="/tasks/{{ card.id }}">Back to the task</a>
      {% else %}
        <form method="post" action="/tasks/{{ card.id }}/delete" novalidate>
          <input type="hidden" name="key" value="{{ key }}">
          <div class="govuk-button-group">
            {{ govukButton({ text: "Yes, delete task", classes: "govuk-button--warning", preventDoubleClick: true }) }}
            <a class="govuk-link" href="/tasks/{{ card.id }}">No, keep it</a>
          </div>
        </form>
      {% endif %}
    </div>
  </div>
{% endblock %}
